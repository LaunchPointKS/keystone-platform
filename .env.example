# Working title. This can change without renaming the codebase immediately.
APP_NAME=Keystone
APP_VERSION=0.1.0
NODE_ENV=development

# API
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
EXPO_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_APP_NAME=Keystone
EXPO_PUBLIC_APP_NAME=Keystone

# Local PostgreSQL
POSTGRES_USER=keystone
POSTGRES_PASSWORD=keystone_local
POSTGRES_DB=keystone
POSTGRES_PORT=5432
DATABASE_URL=postgresql://keystone:keystone_local@localhost:5432/keystone?schema=public

# Local Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Local S3-compatible storage
MINIO_ROOT_USER=keystone
MINIO_ROOT_PASSWORD=keystone_local_storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=keystone-local
S3_ACCESS_KEY_ID=keystone
S3_SECRET_ACCESS_KEY=keystone_local_storage
S3_FORCE_PATH_STYLE=true
